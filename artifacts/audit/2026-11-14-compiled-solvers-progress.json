  "functionality": [
    "SolveCompiledResidualSystem selects real FrankenNumPy, FrankenSciPy finite-difference, FrankenSciPy analytic, or sparse root consumers without fallback or derivative regeneration.",
    "SolveCompiledLeastSquares selects actual dense or sparse consumers, retaining inconsistent, rank-deficient and underdetermined distinctions.",
    "MinimizeCompiledObjective reuses the admitted gradient and sparse Hessian for bounded approximate descent.",
    "Locally compiled and source-bound replayed programs share these consumers, immutable source/context and original-domain guards.",
    "Controls, point conversion, unsuccessful trials, consumer work and response admission share ordinary cumulative resources; verifier reserves are not consumed by proposals.",
    "Outputs label approximate binary64 convergence or stationarity, never a root/minimum proof; failed operations retain program handles."
  ],
  "limits": {
    "session_variables": 16,
    "session_residuals": 64,
    "configured_iteration_cap": 1024,
    "fixed_scipy_iterations": 200,
    "fixed_scipy_residual_tolerance": 1e-10,
    "number_string_bytes": 512
  },
