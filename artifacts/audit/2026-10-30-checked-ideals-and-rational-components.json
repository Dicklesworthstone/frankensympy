  "containing_commit": "The public mixed-family integration, shared Dummy identity fix and this audit are committed together; no tracked self-SHA is asserted.",
  "features": {
    "mixed_components": {
      "native_apis": [
        "metered_rational_components_system",
        "rational_components_system"
      ],
      "receipts": [
        "VerifiedPolynomialComponents",
        "VerifiedComponentFamily"
      ],
      "verification": "Retain independent exact split-product/branch-coverage checks and exact original leaf binding. Each leaf is a checked polynomial graph or a complete checked rational graph. Ideal-based containment removes only established subcomponents; unknown leaves prevent publication. A whole-node checked rational graph can recover a hidden ideal after unsupported intermediate splits.",
      "public": "nonlinsolve transfers separate numerator/denominator/nonzero-condition rows for each component. Python validates all row widths and guards, constructs held reciprocals, and keeps each component's domain independent. Existing polynomial-only and single-rational-family bridge shapes remain. The duplicate whole-node retry is removed.",
      "examples": [
        "x*(x*y-1)=0 -> (0,y) union (1/y,y), with y!=0 only on the rational row",
        "(x*y-1)*(x*(y-1)-1)=0 keeps the y and y-1 exclusions on separate rows",
        "Independent mixed choices form the complete Cartesian union"
      ],
      "bounds": {
        "variables": 8,
        "equations": 64,
        "tree_nodes": 63,
        "components": 32,
        "tree_depth": 16,
        "compute_per_lane": 200000000,
        "bytes_per_lane": 536870912
      },
      "limits": "Bounded recognized graphs and checked factor splits, not arbitrary positive-dimensional decomposition. Original reciprocal equations and general algebraic-coefficient families remain unsupported. Legacy polynomial-only entry points do not perform rational search."
    },
    "ideal_operations": {
      "native_apis": [
        "checked_elimination_ideal",
        "checked_ideal_intersection",
        "checked_ideal_saturation"
      ],
      "receipt": "VerifiedIdealOperation",
      "verification": "Independently bind every ambient construction coefficient and typed ring to the original request, then require the complete projected subset of an immutable accepted Lex Gröbner basis. Elimination moves selected variables to a leading block; intersection uses tI+(1-t)J; saturation uses I+<1-tf>.",
      "public": [
        "GroebnerBasis.eliminate(*generators)",
        "GroebnerBasis.intersection(other)",
        "GroebnerBasis.saturate(polynomial)"
      ],
      "semantics": "Explicit FrankenSymPy extensions over QQ. Retained variables keep their original order; constant-ring zero/unit ideals are supported. ZZ coefficients are extended to QQ. Saturation returns ideal closure I:f^infinity, not the pointwise removal of f=0.",
      "source_admission": "Bound original lists and borrowed names before copying. Check raw Python integer bit length before conversion and borrow native coefficients before inspecting surface children. After full native subtree preflight, inspect only retained original Python _args/_struct_args, avoiding recursive native .args copies while preserving held/custom-source refusals.",
      "bounds": {
        "ambient_variables_including_auxiliary": 8,
        "original_variables_for_intersection_and_saturation": 7,
        "constructed_equations": 64,
        "coefficient_bits": 4096,
        "source_nodes": 4096,
        "source_depth": 64,
        "compute_per_lane": 20000000,
        "bytes_per_lane": 134217728
      }
    },
    "dummy_identity": {
      "defect": "Reserved-name lifting reconstructed equal Dummy objects, and constructor/native plain bindings exposed different placeholder digests so registry keys disagreed.",
      "fix": "Register exact Dummy owners and lift them through the typed surface registry. Normalize explicitly plain bindings to (name,None); preserve the exact digest for every declared typed identity, including zero.",
      "regressions": "Original Dummy objects remain in free coordinates and held reciprocal bases in both caller orders. Same-intern-name unregistered typed identities refuse and cannot capture a plain owner."
    }
  },
